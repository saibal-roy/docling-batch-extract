# Server sizing for docling-serve, read by docker-compose.yml. scripts/setup_ubuntu.sh writes .env
# for the machine it runs on; copy this file to .env to set it by hand.
#
# 2 vCPU / 8 GB (validated target): DOCLING_WORKERS=1  DOCLING_THREADS=2  DOCLING_MEMORY=6500M
# Larger machines (written by setup, NOT validated): 2 threads per worker, workers = vCPUs / 2,
# memory = RAM - 1.5 GB. Benchmark them with tests/profile_benchmark.sh before relying on them.
DOCLING_WORKERS=1
DOCLING_THREADS=2
DOCLING_MEMORY=6500M
